{
  "packages": ["github:numtide/llm-agents.nix#codex"],
  "routes": [
    {
      "name": "openai",
      "host": "api.openai.com",
      "auth": { "type": "bearer", "token": "OPENAI_API_KEY" }
    }
  ],
  "setup": {
    "command": "printenv OPENAI_API_KEY | codex login --with-api-key",
    "check": "codex login status 2>&1 | grep -q 'using an API key'"
  }
}
