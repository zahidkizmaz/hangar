{
  "credentials": { "GITHUB_GIT_USER": "x-access-token" },
  "routes": [
    {
      "name": "github-api",
      "host": "api.github.com",
      "auth": { "type": "bearer", "token": "GITHUB_TOKEN" }
    },
    {
      "name": "github-git",
      "host": "github.com",
      "auth": { "type": "basic", "username": "GITHUB_GIT_USER", "password": "GITHUB_TOKEN" }
    },
    { "name": "github-codeload", "host": "codeload.github.com", "auth": { "type": "passthrough" } },
    { "name": "github-objects", "host": "objects.githubusercontent.com", "auth": { "type": "passthrough" } },
    {
      "name": "github-release-assets",
      "host": "release-assets.githubusercontent.com",
      "auth": { "type": "passthrough" }
    }
  ]
}
