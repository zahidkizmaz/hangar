{
  "appDefinitions": {
    "web": {
      "ports": [{ "name": "web", "vm": 3100, "purpose": "Example web UI" }]
    }
  },
  "bays": [
    {
      "name": "default",
      "apps": ["nix", "github-token", "claude-code", "web"],
      "image": "ghcr.io/example/hangar-bay:latest",
      "packages": ["github:numtide/llm-agents.nix#codex"],
      "env": { "EXAMPLE_MODE": "demo" },
      "run": { "web": "serve --port 3100" },
      "files": { "~/.config/app/config.toml": "~/dotfiles/app/config.toml" },
      "mounts": { "~/.app-data": { "host": "~/work/app-data", "writable": true } },
      "cache": false
    },
    {
      "name": "oss",
      "home": false,
      "image": "example/bay:dev",
      "imageLoader": "/nix/store/00000000000000000000000000000000-bay-image"
    }
  ],
  "tower": {
    "credentialFiles": { "GITHUB_TOKEN": "/run/secrets/github-token" },
    "routes": []
  }
}
