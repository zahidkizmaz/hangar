{
  "proxies": {
    "vault": {
      "kind": "infisical",
      "run": "managed",
      "secrets": {
        "session-token": { "command": ["cat", "/run/secrets/session"] }
      }
    }
  },
  "defaults": { "proxy": "vault" },
  "apps": {
    "web": {
      "ports": [{ "name": "web", "vm": 3100, "purpose": "Example web UI" }]
    }
  },
  "sandbox": { "backend": "msb" },
  "bays": [
    {
      "name": "default",
      "apps": ["claude-code", "web"],
      "image": "ghcr.io/example/hangar-bay:latest",
      "packages": ["github:numtide/llm-agents.nix#codex"],
      "env": { "EXAMPLE_MODE": "demo" },
      "ports": { "web": 3200 },
      "cpus": 2,
      "memory": "8G",
      "mounts": {
        "~/notes": { "host": "~/notes", "mode": "ro" },
        "~/projects": { "host": "~/work/projects", "mode": "rw" },
        "~/.config/app": { "host": "~/dotfiles/app", "mode": "copy" }
      }
    },
    {
      "name": "oss",
      "proxy": null,
      "imageRepository": "ghcr.io/example/hangar-bay",
      "disk": "60G",
      "image": "example/bay:dev",
      "imageLoader": "/nix/store/00000000000000000000000000000000-bay-image"
    }
  ]
}
